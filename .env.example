# Base de datos PostgreSQL
DEMO_MODE="false"
DATABASE_URL="postgresql://padel:padel@localhost:5432/padel?schema=public"
# En serverless usa pocas conexiones por instancia.
DB_POOL_MAX="2"

# URL pública sin barra final
APP_URL="http://localhost:3000"

# Administrador inicial. En producción utiliza ADMIN_PASSWORD_HASH.
ADMIN_EMAIL="admin@clubpadel.local"
ADMIN_PASSWORD="Cambiar123!"
ADMIN_PASSWORD_HASH=""
SESSION_SECRET="cambia-esta-clave-por-una-de-al-menos-32-caracteres"

# Zona horaria del club
CLUB_TIMEZONE="Europe/Madrid"
CLUB_NAME="Club de Pádel Demo"

# mock: registra los mensajes y permite probar enlaces sin enviar WhatsApp.
# live: usa WhatsApp Business Platform Cloud API.
WHATSAPP_MODE="mock"
WHATSAPP_GRAPH_VERSION="v25.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="cambiar-token-webhook"
WHATSAPP_TEMPLATE_NAME="convocatoria_padel"
WHATSAPP_TEMPLATE_LANGUAGE="es"
